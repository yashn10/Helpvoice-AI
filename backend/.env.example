# ==========================================
# APPLICATION
# ==========================================

NODE_ENV=development
PORT=3000

# Frontend URL(s)
FRONTEND_URL=http://localhost:4200


# ==========================================
# DATABASE
# ==========================================

MONGODB_URI=mongodb://localhost:27017/helpvoice-ai


# ==========================================
# GROQ AI
# ==========================================

GROQ_API_KEY=

# Primary model
GROQ_PRIMARY_MODEL=

# Secondary fallback model
GROQ_SECONDARY_MODEL=

# Tertiary fallback model
GROQ_TERTIARY_MODEL=

# Lightweight fallback model
GROQ_QUATERNARY_MODEL=

# Speech-to-text model
GROQ_STT_MODEL=


# ==========================================
# AI CONFIGURATION
# ==========================================

AI_REQUEST_TIMEOUT_MS=8000

AI_MAX_RETRIES_PER_MODEL=1

AI_FALLBACK_ENABLED=true

AI_LOCAL_FALLBACK_ENABLED=true

AI_CONFIDENCE_THRESHOLD=0.60


# ==========================================
# EMERGENCY
# ==========================================

DEFAULT_EMERGENCY_NUMBER=112


# ==========================================
# HOSPITAL PROVIDER
# ==========================================

HOSPITAL_PROVIDER=demo

OSM_OVERPASS_URL=

HOSPITAL_SEARCH_RADIUS_KM=15


# ==========================================
# MAP
# ==========================================

MAP_PROVIDER=osm

MAP_API_KEY=


# ==========================================
# DEMO
# ==========================================

ENABLE_DEMO_MODE=true

DEMO_LOCATION_LAT=

DEMO_LOCATION_LNG=


# ==========================================
# SECURITY
# ==========================================

RATE_LIMIT_WINDOW_MS=900000

RATE_LIMIT_MAX_REQUESTS=100
